# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
.ruff_cache/
# IDE e ambiente
.vscode/
.idea/
.env
# Saídas geradas (diretórios mantidos pelo .gitkeep)
resultados/*
